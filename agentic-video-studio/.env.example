# Agentic Video Studio — Environment Configuration
# Copy this file to .env and fill in your API keys

# ── B-Roll API Keys ───────────────────────────────────────
# Pexels (free, recommended): https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Pixabay (free): https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key_here

# ── Optional: ElevenLabs / TTS for audiogram voiceovers ──
# ELEVENLABS_API_KEY=

# ── Optional: OpenAI (for GPT-based semantic analysis) ───
# OPENAI_API_KEY=
